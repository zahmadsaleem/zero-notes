{
  "manifest_version": 3,
  "name": "Local Text Notes",
  "version": "1.0.0",
  "minimum_chrome_version": "105",
  "description": "Highlight text and leave local comments on the sites you enable.",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*", "file:///*"],
  "action": {
    "default_title": "Local Text Notes",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
